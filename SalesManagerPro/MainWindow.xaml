<Window x:Class="SalesManagerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SalesManagerPro"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="ПОКАЗАТИ КЛІЄНТІВ" Click="Button_Click" Height="40" Margin="10" Background="LightBlue" FontWeight="Bold" />
            <DataGrid x:Name="MyGrid" Height="320" Margin="10" AutoGenerateColumns="True" />
        </StackPanel>
    </Grid>
</Window>
